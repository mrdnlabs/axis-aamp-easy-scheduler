# AAM Pro API credentials — copy this file to .aamp_credentials and fill in values.
# The real file (.aamp_credentials) is gitignored and must NEVER be committed.
#
# Loading order (first match wins):
#   1. Explicit kwargs to load_config()
#   2. Environment variables (same key names, e.g. $env:AAMP_USER)
#   3. .aamp_credentials in this project root
#   4. .aamp_credentials in your home directory
#
# All settings here can also be set as environment variables — use whichever
# you prefer.

# ---------------------------------------------------------------------------
# AAM Pro REST API + IAM
# ---------------------------------------------------------------------------

# Where AAM Pro's web UI / REST proxy is. https://localhost when running on
# the AAM Pro server itself. Use the public hostname when running remotely.
AAMP_HOST=https://localhost

# AAM Pro user with admin rights. Created in the AAM Pro SPA Settings →
# Users panel. Don't reuse a Windows account — make a dedicated one.
AAMP_USER=your_aamp_admin_username

# Password for AAMP_USER.
AAMP_PASSWORD=your_aamp_admin_password

# Skip TLS verification for AAM Pro's self-signed cert. Set true for
# development; set false (and trust the cert) in production.
AAMP_VERIFY_TLS=false

# ---------------------------------------------------------------------------
# ElevenLabs voice generation (optional)
# ---------------------------------------------------------------------------

# API key from elevenlabs.io. Only needed if you want to use the
# generate_announcement_audio MCP tool. Leave empty to disable voice features.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Axis device VAPIX credentials (for device onboarding)
# ---------------------------------------------------------------------------

# Username Axis devices accept for admin. Usually "root".
AAMP_DEVICE_DEFAULT_USER=root

# Password set on freshly provisioned devices AND tried first against
# already-provisioned devices. Pick a strong password; this is the fleet
# default. Leave empty if you don't plan to onboard devices.
AAMP_DEVICE_DEFAULT_PASSWORD=

# Comma-separated list of additional passwords to try when the default fails.
# Useful when inheriting a heterogeneous fleet that has mixed passwords.
# Example: AAMP_DEVICE_PASSWORD_CANDIDATES=oldpassword1,oldpassword2,vendor_default
AAMP_DEVICE_PASSWORD_CANDIDATES=

# Optional: hostname/IP that audio devices should use to reach this AAM Pro
# server. Empty = auto-detect per-device by inferring which local interface
# routes to each device (correct for multi-homed servers).
# Set this when:
#   - AAM Pro is behind NAT and devices must use a public hostname
#   - You want devices to use an FQDN instead of an IP
#   - The per-device inference picks the wrong interface
# Examples:
#   AAMP_DEVICE_FACING_HOST=10.0.5.50
#   AAMP_DEVICE_FACING_HOST=aam-pro.school.edu
AAMP_DEVICE_FACING_HOST=
