# Credentials — never commit
.aamp_credentials
.env

# Per-user state
.browser-state/
.venv/
.claude/settings.local.json

# Generated
logs/
intent/site_*.md
*.egg-info/
__pycache__/
*.pyc

# Device-onboarding parameter cache (per-deployment, not source-of-truth)
.aamp_axis_paramcache.json

# Migration backups created by `aamp-migrate-credentials`
.aamp_credentials.bak.*
# Credential-access audit log (also lives in ~ by default — informational)
.aamp_audit.log

# Extracted AAM Pro internals (proprietary, do not redistribute)
BOOT-INF/

# Per-user ElevenLabs-generated voice samples (each user generates their own
# via the API). The CC0/CC-BY redistributable sets in bells/, effects/, music/
# are committed.
assets/voice/

# IDE
.vscode/
.idea/
